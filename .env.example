# Copy to .env and fill in for a live site. Never commit the real .env.

# Frontend (Vite) - where the backend API lives
VITE_API_URL=http://localhost:5000/api

# Backend (Flask)
LAUNCHPAD_SECRET=replace-with-a-long-random-string
LAUNCHPAD_ORIGINS=http://localhost:5173
# Set to 1 once the site is served over HTTPS
LAUNCHPAD_SECURE_COOKIES=0
