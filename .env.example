# Copy to .env and fill in for a live site. Never commit the real .env.

# Frontend (Vite) - where the backend API lives
VITE_API_URL=http://localhost:5000/api

# Backend (Flask)
LAUNCHPAD_SECRET=replace-with-a-long-random-string
LAUNCHPAD_ORIGINS=http://localhost:5173
# Set to 1 once the site is served over HTTPS
LAUNCHPAD_SECURE_COOKIES=0

# Interview practice AI (Alex). Uses Ollama on this computer - see backend/AI_SETUP.md.
# Set LAUNCHPAD_AI=off to always use the standard (rule-based) replies.
LAUNCHPAD_AI=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=15
